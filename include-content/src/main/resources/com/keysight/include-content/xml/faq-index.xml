<at:declarations>
   <at:var at:name="createFromTemplateMacro"/>       
   <at:var at:name="contentReportTableMacro"/>       
   <at:var at:name="recentActivityMacro"/>       
   <at:var at:name="contributorsMacro"/>       
</at:declarations>

<ac:layout>
   <ac:layout-section ac:type="single">
      <ac:layout-cell>
         <p style="text-align: right;">
            <at:var at:name="createFromTemplateMacro" at:rawxhtml="true"/>
         </p>
      </ac:layout-cell>
   </ac:layout-section>

   <ac:layout-section ac:type="single">
      <ac:layout-cell>
         <p>
            <ac:structured-macro ac:name="faq" />
         </p>
      </ac:layout-cell>
   </ac:layout-section>

   <ac:layout-section ac:type="two_equal">
      <ac:layout-cell>
         <h2>Recent FAQ Activity</h2>
         <p>
            <at:var at:name="recentActivityMacro" at:rawxhtml="true"/>
         </p>
      </ac:layout-cell>
      <ac:layout-cell>
         <h2>Contributors</h2>
         <p>
            <at:var at:name="contributorsMacro" at:rawxhtml="true"/>
         </p>
      </ac:layout-cell>
   </ac:layout-section>

</ac:layout>
