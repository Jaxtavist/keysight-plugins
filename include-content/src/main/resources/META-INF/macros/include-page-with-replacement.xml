<?xml version="1.0" encoding="UTF-8"?>
<module-container>

        
   <!-- add our i18n resource -->
   <resource type="i18n" name="include-page-with-replacement" location="/com/keysight/include-content/i18n/include-page-with-replacement"/>
 
   <xhtml-macro name="include-page-with-replacement" key="include-page-with-replacement" 
                class="com.keysight.include.content.macros.IncludePageWithReplacement"
                icon="/download/resources/com.keysight.include-content:include-content-resources/images/keysight-logo-80x80.png">
      <category name="confluence-content" />
      <parameters>
         <parameter name="page" type="confluence-content" required="true">
            <option key="includeDatePath" value="true" />
         </parameter>
         <parameter name="delimiter" type="string" default="/" />
      </parameters>
      <property-panel>
         <button id="goto-target-page" label="Go to Included Page"/>
      </property-panel>
   </xhtml-macro>

</module-container>

