      </tr>
      <tr>
         <th>Estimated time to complete:</th>
         <td><ac:placeholder>An hour</ac:placeholder></td>
      </tr>
      <tr>
         <th>Applicable to:</th>
         <td><ac:placeholder>example: Gondor, TCE</ac:placeholder></td>
      </tr>
   </tbody>
</table>
            </ac:rich-text-body>
         </ac:structured-macro>
      </ac:layout-cell>
