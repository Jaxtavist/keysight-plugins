#set( $images = "$webResourceManager.getStaticResourcePrefix()/download/resources/com.keysight.database:database-admin-config-general-resources/images" )
#set( $check = "$images/check.png" )
#set( $error = "$images/error.png" )
#set( $warning = "$images/warning.png" )

##<img class="emoticon emoticon-tick" src="$check" data-emoticon-name="tick" alt="(tick)"/>
##<img class="emoticon emoticon-cross" src="$error" data-emoticon-name="cross" alt="(error)"/>
##<img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning" alt="(warning)"/>

<html>
    <head>
        <title>Database Support Admin</title>
        <meta name="decorator" content="atl.admin"/>
        $webResourceManager.requireResource("com.keysight.database:database-admin-config-general-resources")
        $webResourceManager.requireResource("com.keysight.database:database-admin-config-resources")
    </head>
    <body>
        <form id="database-admin-config" class="aui">

            <h2>Installed JDBC Drivers</h2>

            <p>In order to communicate with an external relational database system
                such as mysql, the jdbc drivers need to be provided. For licensing reasons,
                these cannot be distributed with the plugin. This plugin expects the drivers
                to be located on the local file system in a user defined folder. Inside the
                folder there should be child folders named as below (including case and spaces).
                Each of the child folders needs to contains the jar file from the service
                provider that contains the jdbc driver for that database manager. For example,
                if the driver folder is <b>\JdbcDrivers</b>, this plugin will be looking
                for the MySQL jar file in <b>\JdbcDrivers\MySQL</b>
                (<b>\JdbcDrivers\MySQL\mysql-connector-java-5.1.40.bin.jar</b>).</p>

            <table width="100%" border="0">
                <tr>
                    <td>
                        <ul>
                            <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                     alt="(warning)"/> DB2
                            </li>
                            <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                     alt="(warning)"/> Derby
                            </li>
                        </ul>
                    </td>
                    <td>
                        <ul>
                            <li>Microsoft SQL Server</li>
                            <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                     alt="(warning)"/> MongoDB
                            </li>
                        </ul>
                    </td>
                    <td>
                        <ul>
                            <li>MySQL</li>
                            <li>Oracle</li>
                        </ul>
                    </td>
                    <td>
                        <ul>
                            <li>PostgreSQL</li>
                            <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                     alt="(warning)"/> Sybase
                            </li>
                        </ul>
                    </td>
                </tr>
            </table>

            <p>The <img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning" alt="(warning)"/> icon is
                for database connections that have not been tested with this plugin.</p>

            <hr/>

            <p> Please provide the local directory where the folders containing the jdbc
                driver .jar files will be found. Note, paths on windows should be
                specified as <b>C:\\JdbcDrivers</b> (with double slashes) while linux paths
                should look like <b>/JdbcDrivers</b>. Paths may be absolute or relative. If
                relative, they are relative to the directory <b>$relativeHome</b>.</p>

            <div class="config-input-container">
                <div class="config-input-row">
                    <div class="config-input-cell">
                        <div class="field-group">
                            <label for="jdbc-driver-directory">Driver Directory</label>
                            <input class="text full-width-field" type="text" id="jdbc-driver-directory"
                                   name="jdbc-driver-directory" title="JDBC Driver Directory">
                            <div class="error add-group-error"></div>
                        </div>
                    </div>
                    <div class="config-input-cell">
                        <div class="field-group right-button">
                            <div class="buttons-container right-button">
                                <input id="save-jdbc-driver-directory" class="button submit" type="submit" value="Save">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <h2>Database Driver Status</h2>
            <div id="installed-drivers-container" class="list-container">
                <table width="100%" border="0">
                    <tr>
                        <td>
                            <ul>
                                #if( $db2 == "ok" )
                                <li><img class="emoticon emoticon-tick" src="$check" data-emoticon-name="tick" alt="(tick)"/>
                                    DB2
                                </li>
                                #elseif( $db2 == "warning" )
                                <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                         alt="(warning)"/> DB2
                                </li>
                                #else
                                <li><img class="emoticon emoticon-cross" src="$error" data-emoticon-name="cross" alt="(error)"/>
                                    DB2
                                </li>
                                #end

                                #if( $derby == "ok" )
                                <li><img class="emoticon emoticon-tick" src="$check" data-emoticon-name="tick" alt="(tick)"/>
                                    Derby
                                </li>
                                #elseif( $derby == "warning" )
                                <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                         alt="(warning)"/> Derby
                                </li>
                                #else
                                <li><img class="emoticon emoticon-cross" src="$error" data-emoticon-name="cross" alt="(error)"/>
                                    Derby
                                </li>
                                #end
                            </ul>
                        </td>
                        <td>
                            <ul>

                                #if( $microsoftSqlServer == "ok" )
                                <li><img class="emoticon emoticon-tick" src="$check" data-emoticon-name="tick" alt="(tick)"/>
                                    Microsoft SQL Server
                                </li>
                                #elseif( $microsoftSqlServer == "warning" )
                                <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                         alt="(warning)"/> Microsoft SQL Server
                                </li>
                                #else
                                <li><img class="emoticon emoticon-cross" src="$error" data-emoticon-name="cross" alt="(error)"/>
                                    Microsoft SQL Server
                                </li>
                                #end

                                #if( $mongoDb == "ok" )
                                <li><img class="emoticon emoticon-tick" src="$check" data-emoticon-name="tick" alt="(tick)"/>
                                    MongoDB
                                </li>
                                #elseif( $mongoDb == "warning" )
                                <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                         alt="(warning)"/> MongoDB
                                </li>
                                #else
                                <li><img class="emoticon emoticon-cross" src="$error" data-emoticon-name="cross" alt="(error)"/>
                                    MongoDB
                                </li>
                                #end
                            </ul>
                        </td>
                        <td>
                            <ul>
                                #if( $mySql == "ok" )
                                <li><img class="emoticon emoticon-tick" src="$check" data-emoticon-name="tick" alt="(tick)"/>
                                    MySQL
                                </li>
                                #elseif( $mySql == "warning" )
                                <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                         alt="(warning)"/> MySQL
                                </li>
                                #else
                                <li><img class="emoticon emoticon-cross" src="$error" data-emoticon-name="cross" alt="(error)"/>
                                    MySQL
                                </li>
                                #end

                                #if( $oracle == "ok" )
                                <li><img class="emoticon emoticon-tick" src="$check" data-emoticon-name="tick" alt="(tick)"/>
                                    Oracle
                                </li>
                                #elseif( $oracle == "warning" )
                                <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                         alt="(warning)"/> Oracle
                                </li>
                                #else
                                <li><img class="emoticon emoticon-cross" src="$error" data-emoticon-name="cross" alt="(error)"/>
                                    Oracle
                                </li>
                                #end
                            </ul>
                        </td>
                        <td>
                            <ul>
                                #if( $postgreSql == "ok" )
                                <li><img class="emoticon emoticon-tick" src="$check" data-emoticon-name="tick" alt="(tick)"/>
                                    PostgreSQL
                                </li>
                                #elseif( $postgreSql == "warning" )
                                <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                         alt="(warning)"/> PostgreSQL
                                </li>
                                #else
                                <li><img class="emoticon emoticon-cross" src="$error" data-emoticon-name="cross" alt="(error)"/>
                                    PostgreSQL
                                </li>
                                #end

                                #if( $sybase == "ok" )
                                <li><img class="emoticon emoticon-tick" src="$check" data-emoticon-name="tick" alt="(tick)"/>
                                    Sybase
                                </li>
                                #elseif( $sybase == "warning" )
                                <li><img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning"
                                         alt="(warning)"/> Sybase
                                </li>
                                #else
                                <li><img class="emoticon emoticon-cross" src="$error" data-emoticon-name="cross" alt="(error)"/>
                                    Sybase
                                </li>
                                #end
                            </ul>
                        </td>
                    </tr>
                </table>

                <p>The <img class="emoticon emoticon-tick" src="$check" data-emoticon-name="tick" alt="(tick)"/> icon indicates
                    a local driver is available.<br/>
                    The <img class="emoticon emoticon-warning" src="$warning" data-emoticon-name="warning" alt="(warning)"/>
                    icon indicates a driver can be downloaded on the fly - this works but is slow.<br/>
                    The <img class="emoticon emoticon-cross" src="$error" data-emoticon-name="cross" alt="(error)"/> icon
                    indicates a driver cannot be found. Connections to this type of database will not work.
                </p>
            </div>
        </form>

        <h1>Database Connection Profile Management Permissions</h1>
        <div id="configuration-permissions"></div>

        <h1>Query Performance Security Control Settings</h1>
        <div id="performance-security-controls">
            <p>Confluence admins can set a limit on the number of rows to be received or the time it will take a query
            to run.  If the admin sets a hard row limit, then the plugin will insist that every sql query have the string
            <b>LIMIT X</b> where <b>X</b> is less than or equal to the hard limit before allowing the query to be executed
            on the server.  If there is a soft row limit, then if the query pulls back more rows than the limit, then an
            email will be sent to the configured address.  If the admin sets a hard timeout, the query will exit at that
            time returning an error to the user.  If the admin sets a soft timeout, then if the query takes longer than
            that time, an email will be sent to the configured address.</p>

            <form class="aui">
                <div class="field-group">
                    <label for="row-limit-type">Row Limit Type</label>
                    <select class="select" id="row-limit-type" name="row-limit-type">
                       <option>Soft</option>
                       <option>Hard</option>
                    </select>
                    <div class="description" >A <b>hard</b> limit will require the text <b>LIMIT X</b>, where X is less than
                    the <b>Row Limit Threshold</b>, to be in the SQL. The <b>soft</b> limit will cause an email to be sent to the
                    configured address if a query returns more rows than the threshold limit.</div>
                </div>
                <div class="field-group">
                    <label for="row-limit-value">Row Limit Threshold</label>
                    <input class="text" id="row-limit-value" type="text" name="row-limit-value" placeholder="Optional" value=""/>
                    <div class="description" >The number of rows that can be safely returned.  No value indicates an unlimited
                    number of rows may be returned.</div>
                </div>
                <div class="field-group">
                    <label for="timeout-limit-type">Timeout Type</label>
                    <select class="select" id="timeout-limit-type" name="timeout-limit-type">
                       <option>Soft</option>
                       <option>Hard</option>
                    </select>
                    <div class="description" >A <b>hard</b> limit will cause the query to timeout after <b>X</b> seconds. The
                    <b>soft</b> limit will send an email to the configured address if a query takes longer than <b>X</b> seconds.</div>
                </div>
                <div class="field-group">
                    <label for="timeout-limit-value">Timeout Threshold</label>
                    <input class="text" id="timeout-limit-value" type="text" name="timeout-limit-value" placeholder="Optional" value=""/>
                    <div class="description" >The number of seconds before the timeout threshold is crossed. If no value is
                    provided, no specified timeout for the sql query will be set.</div>
                </div>
                <div class="field-group">
                    <label for="notification-email">Notification Email</label>
                    <input class="text" id="notification-email" type="text" name="notification-email" placeholder="Optional" value=""/>
                    <div class="description" >The email address that will receive the warning when the soft limits are exceeded.</div>
                </div>
                <div class="buttons-container">
                    <div class="buttons">
                        <button class="aui-button" id="save-performance-security-control-settings">Save</button>
                    </div>
                </div>
            </form>
        </div>
    </body>
</html>
