<?xml version="1.0" encoding="UTF-8"?>
<module-container>

   <!-- add our i18n resource -->
   <resource type="i18n" name="database-query" location="/com/keysight/database/i18n/database-query"/>
   
   <xhtml-macro name="database-query" key="database-query" 
                class="com.keysight.database.macros.DatabaseQuery"
                icon="/download/resources/com.keysight.database:database-resources/images/keysight-logo-80x80.png">
      <category name="confluence-content" />
      <parameters>
         <parameter name="database-type" type="enum" required="true">
            <value name="DB2" />
            <value name="Derby" />
            <value name="Microsoft SQL Server" />
            <value name="MongoDB" />
            <value name="MySQL" />
            <value name="Oracle" />
            <value name="PostgreSQL" />
            <value name="Sybase" />
	        <option key="showNameInPlaceholder" value="false" />
	        <option key="showValueInPlaceholder" value="false" />
         </parameter>
         <parameter name="connection-string"  type="string" required="true">
	        <option key="showNameInPlaceholder" value="false" />
	        <option key="showValueInPlaceholder" value="false" />
         </parameter>
         <parameter name="username"  type="string" required="true">
	        <option key="showNameInPlaceholder" value="false" />
	        <option key="showValueInPlaceholder" value="false" />
         </parameter>
         <parameter name="password"  type="string" required="true">
	        <option key="showNameInPlaceholder" value="false" />
	        <option key="showValueInPlaceholder" value="false" />
         </parameter>
      </parameters>
   </xhtml-macro>

</module-container>
