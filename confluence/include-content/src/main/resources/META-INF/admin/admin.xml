<?xml version="1.0" encoding="UTF-8"?>
<module-container>

   <web-resource key="include-content-admin-resources" name="Include Content Admin Web Resources">
      <dependency>com.atlassian.auiplugin:ajs</dependency>
      <dependency>com.atlassian.soy.soy-template-plugin:soy-deps</dependency>

      <!-- transform calls to AJS.getText() inside JS files -->
      <transformation extension="js">
         <transformer key="jsI18n"/>
      </transformation>

      <!-- transform Soy templates into JS -->
      <transformation extension="soy">
         <transformer key="soyTransformer">
            <functions>com.atlassian.confluence.plugins.soy:soy-core-functions</functions>
         </transformer>
      </transformation>

      <resource type="download" name="include-content.css"      location="/css/include-content.css"/>
      <resource type="download" name="include-content-admin.js" location="/js/include-content-admin.js"/>
      <resource type="download" name="admin-ui-templates.js"    location="/soy/admin-ui-templates.soy"/>
      <resource type="download" name="images/" location="/images"/>
   </web-resource>

   <rest name="Include Content Admin Rest Interface" key="include-content-admin-rest-resource" path="/include-content-admin" version="1.0">
      <description>Provides the Admin REST resources for the include content plugin.</description>
   </rest>
 
   <servlet key="admin-servlet" class="com.keysight.include.content.helpers.AdminUI">
      <url-pattern>/include-content/admin</url-pattern>
   </servlet>

</module-container>

