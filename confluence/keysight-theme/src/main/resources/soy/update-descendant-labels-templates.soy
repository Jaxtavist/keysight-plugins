{namespace Keysight.Update.Descendant.Labels.Templates}

/**
 * Update Descendant Labels Dialog2
 */
{template .updateDescendantLabelsDialog}
    <section id="keysight-update-descendant-labels-dialog" role="dialog" class="aui-layer aui-dialog2 aui-dialog2-medium" data-aui-modal="true" aria-hidden="true">

        <!-- Dialog header -->
        <header class="aui-dialog2-header">
            <!-- The dialog's title -->
            <h2 class="aui-dialog2-header-main">Update Descendant Labels</h2>
        </header>

        <!-- Main dialog content -->
        <div class="aui aui-dialog2-content">
           <form class="aui">
               <div class="field-group">
                  <label for="keysight-labels-to-update">Labels</label>
                  <input class="text" name="keysight-labels-to-update" id="keysight-labels-to-update"/>
                  <div class="error hidden"></div>
                </div>

                <div id="keysight-update-descendant-labels-progress-container" class="keysight-hidden" >
                   <div> <hr/> </div>
                   <div id="keysight-update-descendant-labels-progress-text"></div>
                   <div class="button-spinner" id="keysight-update-descendant-labels-progress-spinner"></div>
                </div>
           </form>
        </div>

        <!-- Dialog footer -->
        <footer class="aui-dialog2-footer">
            <!-- Actions to render on the right of the footer -->
            <div class="aui-dialog2-footer-actions">
                <button id="dialog-close-button" class="aui-button aui-button-link" onclick="keysightUpdateDescendantLabels.closeUpdateDescendantLabelsDialog();">Close</button>
                <button id="dialog-remove-labels-button" class="aui-button aui-button-primary" onclick="keysightUpdateDescendantLabels.updateLabels('remove');">Remove Labels</button>
                <button id="dialog-add-labels-button" class="aui-button aui-button-primary" onclick="keysightUpdateDescendantLabels.updateLabels('add');">Add Labels</button>
            </div>
            <!-- Hint text is rendered on the left of the footer -->
            <div class="aui-dialog2-footer-hint"></div>
        </footer>
    </section>
{/template}
