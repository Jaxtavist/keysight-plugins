{namespace Keysight.Keysight.Theme.Admin.Config.Templates}

/**
 * Credentials Container
 */
{template .config}
   <div class="config-container">
      <div class="config-row">
         <div class="config-cell">
            <div class="field-group">
               <label for="name">Notification Email</label>
               <input size="50" type="text long-field" class="text keysight-theme-on-space-creation-email">
            </div>
         </div>
         <div class="config-cell">
            <div class="field-group keysight-theme-remove-button-container">
               <input class="aui-button on-space-creation-email-remove" id="keysight-theme-remove-button" type="button" value="Remove Entry">
            </div>
         </div>
      </div>
   </div>
{/template}
