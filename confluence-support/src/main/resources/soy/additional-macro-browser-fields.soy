{namespace MacroBrowser.AdditionalFieldTypes}

/**
 * Container for a date macro parameter
 */
{template .macroParameterDate}
    <div class="macro-param-div">
        <label></label>
        <input type="date" class="aui-date-picker text" />
    </div>
{/template}

/**
 * Container for an integer macro parameter
 */
{template .macroParameterInteger}
    <div class="macro-param-div">
        <label></label>
        <input type="text" class="text" />
    </div>
{/template}

/**
 * Container for a float macro parameter
 */
{template .macroParameterFloat}
    <div class="macro-param-div">
        <label></label>
        <input type="text" class="text" />
    </div>
{/template}
